#!/bin/bash

alias cls='clear'
alias code='code .'
alias onoff='rm -rf node_modules && npm install'
alias onoffpl='rm -rf node_modules && rm package-lock.json && npm install'
alias kccr='kubectl exec -it $( kubectl get pods -n centralstation --no-headers -o custom-columns=":metadata.name" | grep centralstation-command-runner) -n centralstation -- bash'
